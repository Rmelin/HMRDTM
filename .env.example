# Påkrævet af compose.production.yml.
# Hent kun tokenværdien i Cloudflare Zero Trust > Networks > Tunnels.
# Commit aldrig den rigtige .env-fil.
CLOUDFLARE_TUNNEL_TOKEN=indsæt-dit-tunnel-token-her

# Produktions-admin oprettes i browseren på /admin/login via "Første admin".
# ADMIN_EMAIL og ADMIN_PASSWORD hører kun til det valgfrie lokale demo-seed
# og skal derfor ikke stå i produktionens .env-fil.
